pipeline {
    options {
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
    }
    agent any

    tools {
        maven 'maven-3.9.5'
    }

    stages {
        stage('Code Compilation') {
            steps {
                echo 'Code Compilation is in Progress!'
                sh 'mvn clean compile'
                echo 'Code compilation is Completed and Successful!'
            }
        }
        stage('Code QA Execution') {
            steps {
                echo 'Junit test case checks are in Progress!'
                sh 'mvn clean test'
                echo 'Junit test case checks are Completed and Successful!'
            }
        }
        stage('Code Package') {
            steps {
                echo 'Creating War Artifact'
                sh 'mvn clean package'
                echo 'Creating War Artifact is completed.'
            }
        }
        stage('Building & Tag Docker Image') {
              steps {
                        echo 'Starting Building Docker Image'
                        sh 'docker build -t cicd_ygt:latest .'
                        echo 'Completed Building Docker Image'
                    }
                }

                stage('Docker Image Push to Amazon ECR') {
                    steps {
                        script {
                            withDockerRegistry([credentialsId: 'ecr:ap-south-1:ecr-credentials', url: "https://232265303811.dkr.ecr.ap-south-1.amazonaws.com"]) {
                                sh """
                                echo "List the Docker images present locally"
                                docker images
                                echo "Tagging the Docker Image: In Progress"
                                docker tag cicd_ygt:latest 232265303811.dkr.ecr.ap-south-1.amazonaws.com/cicd_ygt:latest
                                echo "Tagging the Docker Image: Completed"
                                echo "Push Docker Image to ECR: In Progress"
                                docker push 232265303811.dkr.ecr.ap-south-1.amazonaws.com/cicd_ygt:latest
                                echo "Push Docker Image to ECR: Completed"
                                """
                            }
                        }
                    }

    }
}