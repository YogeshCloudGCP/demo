pipeline {
    options {
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '5'))
    }
    agent any

    tools {
        maven 'maven-3.9.5'  // Specify Maven version to be used
    }

    stages {
        stage('Code Compilation') {
            steps {
                echo 'Code Compilation is in Progress!'
                sh 'mvn clean compile'  // Execute Maven clean compile
                echo 'Code Compilation is Completed and Successful!'
            }
        }
        stage('Code QA Execution') {
            steps {
                echo 'JUnit test case checks are in Progress!'
                sh 'mvn clean test'  // Execute Maven clean test
                echo 'JUnit test case checks are Completed and Successful!'
            }
        }
        stage('Code Package') {
            steps {
                echo 'Creating War Artifact'
                sh 'mvn clean package'  // Execute Maven clean package
                echo 'War Artifact Creation Completed.'
            }
        }
    }
    post {
        success {
            echo 'Build and tests were successful!'
        }
        failure {
            echo 'Build failed. Please check the logs for errors.'
        }
        always {
            echo 'Cleaning up and preparing for the next build.'
        }
    }
}
